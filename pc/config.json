{
  "http": {
    "host": "0.0.0.0",
    "port": 8770
  },
  "capture": {
    "backend": "dxcam",
    "output_idx": 0,
    "fps": 60,
    "follow_window": true,
    "process_names": ["maimai.exe", "maimai_dump_.exe"],
    "window_class_substr": "teaGfx",
    "region": null
  },
  "video": {
    "encoder": "auto",
    "bitrate_kbps": 9000,
    "fps": 60,
    "scale": 1.0
  },
  "touch": {
    "backend": "synth",
    "max_contacts": 10,
    "snap_to_zone": false,
    "zone_map": {
      "center": [0.5, 0.5],
      "ring_edges": [0.34, 0.5, 0.66, 0.82, 1.0],
      "sectors": 8,
      "sector_offset_deg": 0.0
    }
  },
  "debug": {
    "log_level": "INFO",
    "save_frames": false
  }
}
