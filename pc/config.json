{
  "http": {
    "host": "0.0.0.0",
    "port": 8770
  },
  "capture": {
    "backend": "dxcam",
    "output_idx": 0,
    "fps": 60,
    "follow_window": true,
    "process_names": [
      "maimai_dump_.exe",
      "maimai.exe"
    ],
    "window_class_substr": "teaGfx",
    "region": null
  },
  "video": {
    "encoder": "auto",
    "bitrate_kbps": 9000,
    "fps": 60,
    "scale": 1.0
  },
  "touch": {
    "backend": "maitouch",
    "process_names": [
      "maimai_dump_.exe",
      "maimai.exe"
    ],
    "max_contacts": 10
  },
  "panel": {
    "auto": true,
    "detect_interval": 0.5,
    "dark_threshold": 24.0,
    "lock_frames": 3,
    "tolerance": 0.04,
    "verify_interval": 2.0,
    "manual": null,
    "roi": [
      0.0,
      0.3,
      0.55,
      1.0
    ]
  },
  "debug": {
    "log_level": "INFO",
    "save_frames": false
  }
}
